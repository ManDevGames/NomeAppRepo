# Supabase project settings (Project Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — NEVER prefix with NEXT_PUBLIC_, never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp number the "Talk About My Result" CTA opens a chat with.
# Digits only, with country code, no + or spaces (e.g. 91XXXXXXXXXX).
WHATSAPP_BUSINESS_NUMBER=91XXXXXXXXXX

# Public site URL, used for metadata/canonical/OG tags, and to build the
# result link sent in the result email below.
NEXT_PUBLIC_SITE_URL=https://pattern.mindurmind.org.in

# Resend (resend.com) API key used to email users their result after they
# submit the assessment. Optional — if unset, the app still works and the
# result is still reachable via its link, it just won't be emailed.
RESEND_API_KEY=your-resend-api-key

# "From" address for the result email. Must be on a domain you've verified
# in Resend. Falls back to Resend's shared onboarding@resend.dev sender
# (fine for testing, not for real users) if unset.
RESEND_FROM_EMAIL="Relationship Pattern Assessment <results@yourdomain.com>"
