# Supabase project settings (Project Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — NEVER prefix with NEXT_PUBLIC_, never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp number the "Talk About My Result" CTA opens a chat with.
# Digits only, with country code, no + or spaces (e.g. 91XXXXXXXXXX).
WHATSAPP_BUSINESS_NUMBER=91XXXXXXXXXX

# Public site URL, used for metadata/canonical/OG tags.
NEXT_PUBLIC_SITE_URL=https://pattern.mindurmind.org.in
